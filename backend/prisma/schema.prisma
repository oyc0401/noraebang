generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Artist {
  id                      Int      @id @default(autoincrement())
  name                    String
  nameKo                  String   @map("name_ko")
  nameNorm                String   @map("name_norm")
  alias                   String   @unique

  blogId                  String?  @map("blog_id")

  youtubeChannelId          String?  @map("youtube_channel_id")
  youtubeChannelTitle       String?  @map("youtube_channel_title")
  youtubeChannelDescription String?  @map("youtube_channel_description")
  youtubeChannelPublished   DateTime? @map("youtube_channel_published")
  youtubeFetchedAt          DateTime? @map("youtube_fetched_at")
  youtubeThumbnail        String?  @map("youtube_thumbnail")
  youtubeThumbnailDefault String?  @map("youtube_thumbnail_default")
  youtubeThumbnailMedium  String?  @map("youtube_thumbnail_medium")
  youtubeThumbnailHigh    String?  @map("youtube_thumbnail_high")
  tjSongRequestUrl        String?  @map("tj_song_request_url")

  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt      @map("updated_at")

  songs                   Song[]   @relation("Artist")
  youtubeChannel          YoutubeChannel?

  @@map("artist")
}

model Song {
  id               Int       @id @default(autoincrement())
  title            String
  titleKo          String?   @map("title_ko")
  titleNorm        String    @map("title_norm")

  youtubeVideoId   String?   @map("youtube_video_id")
  youtubeFetchedAt DateTime? @map("youtube_fetched_at")

  artistId  Int       @map("artist_id")
  artist    Artist    @relation("Artist", fields: [artistId], references: [id])

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt      @map("updated_at")

  karaokeSongs     KaraokeSong[]

  @@unique([artistId, titleNorm])
  @@map("song")
}

model KaraokeSong {
  id              Int       @id @default(autoincrement())
  songId          Int       @map("song_id")

  provider        Provider
  karaokeNo       String    @map("karaoke_no")

  providerSongUrl String?   @map("provider_song_url")
  lastSeenAt      DateTime? @map("last_seen_at")
  ingestedAt      DateTime? @map("ingested_at")
  ingestedFrom    String?   @map("ingested_from")

  song            Song      @relation(fields: [songId], references: [id])

  @@unique([provider, karaokeNo])
  @@map("karaoke_song")
}

enum Provider {
  TJ
  KY
  JOYSOUND
}

model YoutubeChannel {
  id                     Int       @id @default(autoincrement())
  artistId               Int       @unique @map("artist_id")

  channelId              String    @unique @map("channel_id")
  title                  String?
  description            String?   @db.Text
  customUrl              String?   @map("custom_url")
  publishedAt            DateTime? @map("published_at")
  country                String?
  defaultLanguage        String?   @map("default_language")

  thumbnailDefault       String?   @map("thumbnail_default")
  thumbnailMedium        String?   @map("thumbnail_medium")
  thumbnailHigh          String?   @map("thumbnail_high")

  subscriberCount        Int?      @map("subscriber_count")
  videoCount             Int?      @map("video_count")
  viewCount              BigInt?   @map("view_count")
  hiddenSubscriberCount  Boolean?  @map("hidden_subscriber_count")

  uploadsPlaylistId      String?   @map("uploads_playlist_id")

  fetchedAt              DateTime? @map("fetched_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  artist                 Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@map("youtube_channel")
}
