generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Artist {
  id               Int             @id @default(autoincrement())
  alias            String?         @unique // 아티스트의 경로이지만, null이라면 userId로 접근가능.
  name             String
  nameKo           String          @map("name_ko")
  tjSongRequestUrl String?         @map("tj_song_request_url")

  thumbnailDefault String?         @map("thumbnail_default")
  thumbnailMedium  String?         @map("thumbnail_medium")
  thumbnailHigh    String?         @map("thumbnail_high")
  artistSongs      ArtistSong[]
  youtubeChannel   YoutubeChannel?

  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@map("artist")
}

model Song {
  id               Int           @id @default(autoincrement())
  title            String
  titleKo          String?       @map("title_ko")
  youtubeVideoId   String?       @map("youtube_video_id")
  youtubeFetchedAt DateTime?     @map("youtube_fetched_at")
  thumbnailDefault String?       @map("thumbnail_default")
  thumbnailMedium  String?       @map("thumbnail_medium")
  thumbnailHigh    String?       @map("thumbnail_high")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  karaokeSongs     KaraokeSong[]
  artistSongs      ArtistSong[]

  @@map("song")
}

model ArtistSong {
  id        Int          @id @default(autoincrement())
  artistId  Int          @map("artist_id")
  songId    Int          @map("song_id")
  order     Int          @default(0)
  role      ArtistRole? // main, featuring, collaboration
  createdAt DateTime     @default(now()) @map("created_at")

  artist    Artist       @relation(fields: [artistId], references: [id], onDelete: Cascade)
  song      Song         @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([artistId, songId])
  @@index([songId])
  @@index([artistId])
  @@map("artist_song")
}

model KaraokeSong {
  id              Int       @id @default(autoincrement())
  songId          Int       @map("song_id")
  provider        Provider
  karaokeNo       String    @map("karaoke_no")
  providerSongUrl String?   @map("provider_song_url")
  lastSeenAt      DateTime? @map("last_seen_at")
  ingestedAt      DateTime? @map("ingested_at")
  ingestedFrom    String?   @map("ingested_from")
  song            Song      @relation(fields: [songId], references: [id])

  @@unique([provider, karaokeNo])
  @@map("karaoke_song")
}

model TjSong {
  id String   @id
  title     String
  artist    String?
  artistList String[] @map("artist_list")
  featureList String[] @map("feature_list")
  producerList String[] @map("producer_list")
  lyricist  String?
  lyricistList  String[] @map("lyricist_list")
  composer  String?
  composerList  String[] @map("composer_list")
  nationType String  @map("nation_type")
  releasedYearMonth String @map("released_year_month")
  saved     Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tj_song")
}

model YoutubeChannel {
  id                    Int       @id @default(autoincrement())
  artistId              Int       @unique @map("artist_id")
  channelId             String    @map("channel_id")
  title                 String?
  description           String?
  customUrl             String?   @map("custom_url")
  publishedAt           DateTime? @map("published_at")
  country               String?
  defaultLanguage       String?   @map("default_language")
  thumbnailDefault      String?   @map("thumbnail_default")
  thumbnailMedium       String?   @map("thumbnail_medium")
  thumbnailHigh         String?   @map("thumbnail_high")
  subscriberCount       Int?      @map("subscriber_count")
  videoCount            Int?      @map("video_count")
  viewCount             BigInt?   @map("view_count")
  hiddenSubscriberCount Boolean?  @map("hidden_subscriber_count")
  uploadsPlaylistId     String?   @map("uploads_playlist_id")
  fetchedAt             DateTime? @map("fetched_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  artist                Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([subscriberCount(sort: Desc)])
  @@map("youtube_channel")
}


enum ArtistRole {
  MAIN
  FEATURING
  PRODUCER
}

enum Provider {
  TJ
  KY
  JOYSOUND
}
