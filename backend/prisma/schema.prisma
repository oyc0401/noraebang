generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Artist {
  id               Int              @id @default(autoincrement())
  slug             String?          @unique // 아티스트의 경로이지만, null이라면 userId로 접근가능.
  name             String
  nameKo           String           @map("name_ko")
  spotifyId        String?          @unique @map("spotify_id")
  homeCatalog      String?          @map("home_catalog") // "KPOP" | "JPOP" | "POP" | "CPOP" | etc.
  tjSongRequestUrl String?          @map("tj_song_request_url") // 이거보단 가장 많이등록된 tj아티스트명이 낫지 않을까?

  thumbnailDefault String?          @map("thumbnail_default")
  thumbnailMedium  String?          @map("thumbnail_medium")
  thumbnailHigh    String?          @map("thumbnail_high")

  artistSongs      ArtistSong[]
  youtubeChannels  YoutubeChannel[]
  spotifyArtist    SpotifyArtist?   @relation(fields: [spotifyId], references: [spotifyId])
  aliases          ArtistAlias[]
  tjSongs          ArtistTjSong[]

  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@map("artist")
}

model Song {
  id               Int           @id @default(autoincrement())
  title            String
  titleKo          String?       @map("title_ko")
  catalog          String? // "KPOP" | "JPOP" | "POP" | "CPOP" | etc.
  youtubeVideoId   String?       @map("youtube_video_id")
  youtubeFetchedAt DateTime?     @map("youtube_fetched_at")

  thumbnailDefault String?       @map("thumbnail_default")
  thumbnailMedium  String?       @map("thumbnail_medium")
  thumbnailHigh    String?       @map("thumbnail_high")

  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  karaokeSongs     KaraokeSong[]
  artistSongs      ArtistSong[]
  spotifyTrack     SpotifyTrack?
  aliases          SongAlias[]

  @@map("song")
}

model ArtistSong {
  id        Int          @id @default(autoincrement())
  artistId  Int          @map("artist_id")
  songId    Int          @map("song_id")
  order     Int          @default(0)
  role      ArtistRole? // main, featuring, collaboration
  createdAt DateTime     @default(now()) @map("created_at")

  artist    Artist       @relation(fields: [artistId], references: [id], onDelete: Cascade)
  song      Song         @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([artistId, songId])
  @@index([songId])
  @@index([artistId])
  @@map("artist_song")
}

model KaraokeSong {
  id              Int       @id @default(autoincrement())
  songId          Int       @map("song_id")
  provider        Provider
  karaokeNo       String    @map("karaoke_no")
  providerSongUrl String?   @map("provider_song_url") // 왜있지?
  lastSeenAt      DateTime? @map("last_seen_at") // 지워도 됌
  ingestedAt      DateTime? @map("ingested_at") // 지워도 됌
  ingestedFrom    String?   @map("ingested_from") // 지워도  됌
  song            Song      @relation(fields: [songId], references: [id])

  @@unique([provider, karaokeNo])
  @@map("karaoke_song")
}

model TjSong {
  id               String          @id
  title            String
  artist           String?
  artistList       String[]        @map("artist_list")
  featureList      String[]        @map("feature_list")
  producerList     String[]        @map("producer_list")
  lyricist         String?
  lyricistList     String[]        @map("lyricist_list")
  composer         String?
  composerList     String[]        @map("composer_list")
  thumbnailImg     String?         @map("thumbnail_img")
  publishdate      String?         @map("publishdate")
  youtubeLink      String?         @map("youtube_link")
  saved            Boolean         @default(false) // 지워도 됌
  isMR             Boolean         @default(false) @map("is_mr")
  isMV             Boolean         @default(false) @map("is_mv")
  isOver60         Boolean         @default(false) @map("is_over_60")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  artists          ArtistTjSong[]

  @@map("tj_song")
}

model YoutubeChannel {
  id                    Int         @id @default(autoincrement())
  artistId              Int         @map("artist_id") // nullable로 하기
  type                  ChannelType @default(MAIN)
  channelId             String      @map("channel_id") // 유니크로 하기
  title                 String?
  description           String?
  customUrl             String?     @map("custom_url")
  publishedAt           DateTime?   @map("published_at")
  country               String?
  defaultLanguage       String?     @map("default_language")
  thumbnailDefault      String?     @map("thumbnail_default")
  thumbnailMedium       String?     @map("thumbnail_medium")
  thumbnailHigh         String?     @map("thumbnail_high")
  subscriberCount       Int?        @map("subscriber_count")
  videoCount            Int?        @map("video_count")
  viewCount             BigInt?     @map("view_count")
  hiddenSubscriberCount Boolean?    @map("hidden_subscriber_count")
  uploadsPlaylistId     String?     @map("uploads_playlist_id") // 이게 뭐예요?
  fetchedAt             DateTime?   @map("fetched_at") // 지워도 됌
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  artist                Artist      @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, type])
  @@index([subscriberCount(sort: Desc)]) // 정렬 인덱스 없어도 될 텐데
  @@map("youtube_channel")
}

model SpotifyArtist {
  id               Int                    @id @default(autoincrement())
  spotifyId        String                 @unique @map("spotify_id")
  spotifyUrl       String?                @map("spotify_url")
  name             String
  popularity       Int?
  followers        Int?
  genres           String[]               @default([])
  thumbnailDefault String?                @map("thumbnail_default")
  thumbnailMedium  String?                @map("thumbnail_medium")
  thumbnailHigh    String?                @map("thumbnail_high")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  artist Artist?
  tracks SpotifyArtistTrack[]

  @@map("spotify_artist")
}

model SpotifyArtistTrack {
  id               Int           @id @default(autoincrement())
  spotifyArtistId  Int           @map("spotify_artist_id")
  spotifyTrackId   Int           @map("spotify_track_id")
  createdAt        DateTime      @default(now()) @map("created_at")

  spotifyArtist SpotifyArtist @relation(fields: [spotifyArtistId], references: [id], onDelete: Cascade)
  spotifyTrack  SpotifyTrack  @relation(fields: [spotifyTrackId], references: [id], onDelete: Cascade)

  @@unique([spotifyArtistId, spotifyTrackId])
  @@index([spotifyArtistId])
  @@index([spotifyTrackId])
  @@map("spotify_artist_track")
}


model SpotifyTrack {
  id               Int                    @id @default(autoincrement())
  songId           Int                    @unique @map("song_id")
  spotifyId        String                 @unique @map("spotify_id")
  spotifyUrl       String?                @map("spotify_url")
  name             String
  popularity       Int?
  previewUrl       String?                @map("preview_url")
  isrc             String?
  durationMs       Int?                   @map("duration_ms")
  releaseDate      String?                @map("release_date")
  thumbnailDefault String?                @map("thumbnail_default")
  thumbnailMedium  String?                @map("spotify_medium")
  thumbnailHigh    String?                @map("thumbnail_high")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  song    Song                   @relation(fields: [songId], references: [id], onDelete: Cascade)
  artists SpotifyArtistTrack[]

  @@map("spotify_track")
}


enum ArtistRole {
  MAIN
  FEATURING
  PRODUCER
}

enum Provider {
  TJ
  KY
  JOYSOUND
}

enum ChannelType {
  MAIN
  TOPIC
}

// 검색 전처리용 별칭 테이블
model ArtistAlias {
  id        Int      @id @default(autoincrement())
  artistId  Int      @map("artist_id")
  alias     String
  locale    String // "KO", "JA_KANA", "JA_KANJI", "LATIN"
  kind      String // "SPOTIFY", "YOUTUBE", "ROMANIZATION", "TRANSLATION", "TJ_NAME", "NICKNAME"
  source    String // "OPERATOR", "SYSTEM", "AI", "AUTO"
  createdAt DateTime @default(now()) @map("created_at")

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId,alias, locale, kind])
  @@index([artistId])
  @@index([alias])
  @@map("artist_alias")
}

model SongAlias {
  id        Int      @id @default(autoincrement())
  songId    Int      @map("song_id")
  alias     String
  locale    String // "KO", "JA_KANA", "JA_KANJI", "LATIN"
  kind      String // "SPOTIFY", "YOUTUBE", "ROMANIZATION", "TRANSLATION", "TJ_NAME", "NICKNAME"
  source    String // "OPERATOR", "SYSTEM", "AI", "AUTO"

  createdAt DateTime @default(now()) @map("created_at")

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId, alias, locale, kind])
  @@index([songId])
  @@index([alias])
  @@map("song_alias")
}

model ArtistTjSong {
  id        Int      @id @default(autoincrement())
  artistId  Int      @map("artist_id")
  tjSongId  String   @map("tj_song_id")
  createdAt DateTime @default(now()) @map("created_at")

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tjSong TjSong @relation(fields: [tjSongId], references: [id], onDelete: Cascade)

  @@unique([artistId, tjSongId])
  @@index([artistId])
  @@index([tjSongId])
  @@map("artist_tj_song")
}

