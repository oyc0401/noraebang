generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Artist {
  id                     Int              @id @default(autoincrement())
  name                   String
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  nameKo                 String           @map("name_ko")
  slug                   String?          @unique
  thumbnailDefault       String?          @map("thumbnail_default")
  thumbnailHigh          String?          @map("thumbnail_high")
  thumbnailMedium        String?          @map("thumbnail_medium")
  homeCatalog            String?          @map("home_catalog")
  spotifyId              String?          @map("spotify_id")
  nameJaKana             String?          @map("name_ja_kana")
  nameJaKanji            String?          @map("name_ja_kanji")
  nameLatin              String?          @map("name_latin")
  nameJaPronu            String?          @map("name_ja_pronu")
  tjName                 String?          @map("tj_name")
  tjNameJa               String?          @map("tj_name_ja")
  spotifyTracksFetchedAt DateTime?        @map("spotify_tracks_fetched_at")
  youtubeTracksFetchedAt DateTime?        @map("youtube_tracks_fetched_at")
  tjProposeFetchedAt     DateTime?        @map("tj_propose_fetched_at")
  nameJa                 String?          @map("name_ja")
  spotifyArtist          SpotifyArtist?   @relation(fields: [spotifyId], references: [spotifyId])
  aliases                ArtistAlias[]
  artistSongs            ArtistSong[]
  tjSongs                ArtistTjSong[]
  youtubeChannels        YoutubeChannel[]
  searchClicks           SearchClick[]
  reports                Report[]

  @@index([spotifyId])
  @@index([homeCatalog])
  @@map("artist")
}

model Song {
  id                  Int                @id @default(autoincrement())
  title               String
  titleKo             String?            @map("title_ko")
  youtubeVideoId      String?            @map("youtube_video_id")
  youtubeFetchedAt    DateTime?          @map("youtube_fetched_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  thumbnailDefault    String?            @map("thumbnail_default")
  thumbnailHigh       String?            @map("thumbnail_high")
  thumbnailMedium     String?            @map("thumbnail_medium")
  catalog             String?
  titleJaKana         String?            @map("title_ja_kana")
  titleJaKanji        String?            @map("title_ja_kanji")
  titleLatin          String?            @map("title_latin")
  titleJa             String?            @map("title_ja")
  spotifyTrackGroupId Int?               @map("spotify_track_group_id")
  tjSongId            String?            @unique @map("tj_song_id")
  titleJaPronu        String?            @map("title_ja_pronu")
  titleLatinPronu     String?            @map("title_latin_pronu")
  score               Float?             @map("score")
  visible             Boolean            @default(false)
  artistSongs         ArtistSong[]
  karaokeSongs        KaraokeSong[]
  tjSong              TjSong?            @relation(fields: [tjSongId], references: [id])
  aliases             SongAlias[]
  songProposes        SongPropose[]
  songSpotifyTracks   SongSpotifyTrack[]
  youtubeVideos       SongYoutubeVideo[]
  searchClicks        SearchClick[]
  reports             Report[]

  @@index([youtubeVideoId])
  @@index([catalog])
  @@index([spotifyTrackGroupId])
  @@index([tjSongId])
  @@map("song")
}

model ArtistSong {
  id        Int         @id @default(autoincrement())
  artistId  Int         @map("artist_id")
  songId    Int         @map("song_id")
  createdAt DateTime    @default(now()) @map("created_at")
  role      ArtistRole?
  artist    Artist      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  song      Song        @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([artistId, songId])
  @@index([songId])
  @@index([artistId])
  @@map("artist_song")
}

model KaraokeSong {
  id        Int      @id @default(autoincrement())
  songId    Int      @map("song_id")
  provider  Provider
  karaokeNo String   @map("karaoke_no")
  song      Song     @relation(fields: [songId], references: [id])

  @@unique([provider, karaokeNo])
  @@index([songId])
  @@map("karaoke_song")
}

model TjSong {
  id           String         @id
  title        String
  artist       String?
  artistList   String[]       @map("artist_list")
  lyricist     String?
  lyricistList String[]       @map("lyricist_list")
  composer     String?
  composerList String[]       @map("composer_list")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  featureList  String[]       @map("feature_list")
  producerList String[]       @map("producer_list")
  saved        Boolean        @default(false)
  thumbnailImg String?        @map("thumbnail_img")
  publishdate  String?        @map("publishdate")
  isMR         Boolean        @default(false) @map("is_mr")
  isMV         Boolean        @default(false) @map("is_mv")
  isOver60     Boolean        @default(false) @map("is_over_60")
  youtubeLink  String?        @map("youtube_link")
  artists      ArtistTjSong[]
  song         Song?

  @@map("tj_song")
}

model YoutubeChannel {
  id                    Int                   @id @default(autoincrement())
  artistId              Int                   @map("artist_id")
  channelId             String                @map("channel_id")
  title                 String?
  description           String?
  customUrl             String?               @map("custom_url")
  publishedAt           DateTime?             @map("published_at")
  country               String?
  defaultLanguage       String?               @map("default_language")
  thumbnailDefault      String?               @map("thumbnail_default")
  thumbnailMedium       String?               @map("thumbnail_medium")
  thumbnailHigh         String?               @map("thumbnail_high")
  subscriberCount       Int?                  @map("subscriber_count")
  videoCount            Int?                  @map("video_count")
  viewCount             BigInt?               @map("view_count")
  hiddenSubscriberCount Boolean?              @map("hidden_subscriber_count")
  uploadsPlaylistId     String?               @map("uploads_playlist_id")
  fetchedAt             DateTime?             @map("fetched_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  type                  ChannelType           @default(MAIN)
  artist                Artist                @relation(fields: [artistId], references: [id], onDelete: Cascade)
  videos                YoutubeChannelVideo[]

  @@unique([artistId, type])
  @@index([channelId])
  @@index([subscriberCount(sort: Desc)])
  @@map("youtube_channel")
}

model YoutubeVideo {
  videoId           String                @id @map("video_id")
  ownerChannelId    String?               @map("owner_channel_id")
  title             String?
  description       String?
  publishedAt       DateTime?             @map("published_at")
  thumbnailDefault  String?               @map("thumbnail_default")
  thumbnailMedium   String?               @map("thumbnail_medium")
  thumbnailHigh     String?               @map("thumbnail_high")
  thumbnailStandard String?               @map("thumbnail_standard")
  thumbnailMaxres   String?               @map("thumbnail_maxres")
  viewCount         BigInt?               @map("view_count")
  likeCount         Int?                  @map("like_count")
  commentCount      Int?                  @map("comment_count")
  durationSeconds   Int?                  @map("duration_seconds")
  definition        String?
  caption           Boolean?
  fetchedAt         DateTime?             @map("fetched_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  songs             SongYoutubeVideo[]
  channels          YoutubeChannelVideo[]

  @@map("youtube_video")
}

model SongYoutubeVideo {
  id             Int          @id @default(autoincrement())
  songId         Int          @map("song_id")
  youtubeVideoId String       @map("youtube_video_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  song           Song         @relation(fields: [songId], references: [id], onDelete: Cascade)
  youtubeVideo   YoutubeVideo @relation(fields: [youtubeVideoId], references: [videoId], onDelete: Cascade)

  @@unique([songId, youtubeVideoId])
  @@index([songId])
  @@index([youtubeVideoId])
  @@map("song_youtube_video")
}

model YoutubeChannelVideo {
  id               Int            @id @default(autoincrement())
  youtubeChannelId Int            @map("youtube_channel_id")
  youtubeVideoId   String         @map("youtube_video_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  youtubeChannel   YoutubeChannel @relation(fields: [youtubeChannelId], references: [id], onDelete: Cascade)
  youtubeVideo     YoutubeVideo   @relation(fields: [youtubeVideoId], references: [videoId], onDelete: Cascade)

  @@unique([youtubeChannelId, youtubeVideoId])
  @@index([youtubeChannelId])
  @@index([youtubeVideoId])
  @@map("youtube_channel_video")
}

model SpotifyArtist {
  id         Int                  @id @default(autoincrement())
  spotifyId  String               @unique @map("spotify_id")
  spotifyUrl String?              @map("spotify_url")
  name       String
  popularity Int?
  followers  Int?
  genres     String[]             @default([])
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")
  thumbnails String[]             @default([])
  artists    Artist[]
  tracks     SpotifyArtistTrack[]

  @@index([popularity])
  @@map("spotify_artist")
}

model SpotifyArtistTrack {
  id              Int           @id @default(autoincrement())
  spotifyArtistId Int           @map("spotify_artist_id")
  spotifyTrackId  Int           @map("spotify_track_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  spotifyArtist   SpotifyArtist @relation(fields: [spotifyArtistId], references: [id], onDelete: Cascade)
  spotifyTrack    SpotifyTrack  @relation(fields: [spotifyTrackId], references: [id], onDelete: Cascade)

  @@unique([spotifyArtistId, spotifyTrackId])
  @@index([spotifyArtistId])
  @@index([spotifyTrackId])
  @@map("spotify_artist_track")
}

model SpotifyTrack {
  id                        Int                  @id @default(autoincrement())
  spotifyId                 String               @unique @map("spotify_id")
  spotifyUrl                String?              @map("spotify_url")
  name                      String
  popularity                Int?
  previewUrl                String?              @map("preview_url")
  isrc                      String?
  durationMs                Int?                 @map("duration_ms")
  releaseDate               String?              @map("release_date")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  thumbnails                String[]             @default([])
  disabled                  Boolean              @default(false)
  musicBrainzTitle          String?              @map("musicbrainz_title")
  musicBrainzArtistCreditId String?              @map("musicbrainz_artist_credit_id")
  musicBrainzArtistId       String?              @map("musicbrainz_artist_id")
  musicBrainzRecordingId    String?              @map("musicbrainz_recording_id")
  musicBrainzFetchedAt      DateTime?            @map("musicbrainz_fetched_at")
  songs                     SongSpotifyTrack[]
  artists                   SpotifyArtistTrack[]

  @@index([isrc])
  @@map("spotify_track")
}

model SongSpotifyTrack {
  id             Int          @id @default(autoincrement())
  songId         Int          @map("song_id")
  spotifyTrackId Int          @map("spotify_track_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  song           Song         @relation(fields: [songId], references: [id], onDelete: Cascade)
  spotifyTrack   SpotifyTrack @relation(fields: [spotifyTrackId], references: [id], onDelete: Cascade)

  @@unique([songId, spotifyTrackId])
  @@index([songId])
  @@index([spotifyTrackId])
  @@map("song_spotify_track")
}

model ArtistAlias {
  id        Int      @id @default(autoincrement())
  artistId  Int      @map("artist_id")
  alias     String
  locale    String
  kind      String
  source    String
  createdAt DateTime @default(now()) @map("created_at")
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, alias, locale, kind])
  @@index([artistId])
  @@index([alias])
  @@map("artist_alias")
}

model SongAlias {
  id        Int      @id @default(autoincrement())
  songId    Int      @map("song_id")
  alias     String
  locale    String
  kind      String
  source    String
  createdAt DateTime @default(now()) @map("created_at")
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId, alias, locale, kind])
  @@index([songId])
  @@index([alias])
  @@map("song_alias")
}

model ArtistTjSong {
  id        Int      @id @default(autoincrement())
  artistId  Int      @map("artist_id")
  tjSongId  String   @map("tj_song_id")
  createdAt DateTime @default(now()) @map("created_at")
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tjSong    TjSong   @relation(fields: [tjSongId], references: [id], onDelete: Cascade)

  @@unique([artistId, tjSongId])
  @@index([artistId])
  @@index([tjSongId])
  @@map("artist_tj_song")
}

model User {
  id              Int             @id @default(autoincrement())
  email           String?         @unique
  password        String?
  lastLoginAt     DateTime        @default(now()) @map("last_login_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  sessions        UserSession[]
  searchHistories SearchHistory[]
  searchClicks    SearchClick[]

  @@map("user")
}

model UserSession {
  id                     String    @id
  userId                 Int       @map("user_id")
  refreshTokenHash      String   @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime @map("refresh_token_expires_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_session")
}


model SongPropose {
  id          Int     @id @default(autoincrement())
  songId      Int?    @map("song_id")
  songSinger  String  @map("po_song_singer")
  songTitle   String  @map("po_song_title")
  content     String  @map("po_content")
  name        String  @map("po_name")
  email1      String  @map("po_email1")
  email2      String  @map("po_email2")
  otCode      String  @map("ot_code")
  hit         Int     @default(0) @map("po_hit")
  regdateView String  @map("po_regdate_view")
  saveDate    BigInt  @map("save_date")
  updateDate  BigInt  @map("update_date")
  query       String?
  song        Song?   @relation(fields: [songId], references: [id])

  @@index([songId])
  @@index([query])
  @@index([songId, saveDate, hit])
  @@map("song_propose")
}

enum ArtistRole {
  MAIN
  FEATURING
  PRODUCER
}

enum Provider {
  TJ
  KY
  JOYSOUND
}

enum ChannelType {
  MAIN
  TOPIC
}

model SearchHistory {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  query      String?
  url        String?
  searchedAt DateTime @default(now()) @map("searched_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, searchedAt(sort: Desc)])
  @@index([query])
  @@map("search_history")
}

model SearchClick {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  query     String?
  url       String?
  artistId  Int?     @map("artist_id")
  songId    Int?     @map("song_id")
  source    String?
  clickedAt DateTime @default(now()) @map("clicked_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist    Artist?  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  song      Song?    @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([userId, clickedAt(sort: Desc)])
  @@index([query])
  @@index([artistId])
  @@index([songId])
  @@index([source])
  @@map("search_click")
}

model Report {
  id        Int          @id @default(autoincrement())
  songId    Int?         @map("song_id")
  artistId  Int?         @map("artist_id")
  title     String
  content   String
  email     String?
  status    ReportStatus @default(PENDING)
  adminNote String?      @map("admin_note")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  song      Song?        @relation(fields: [songId], references: [id], onDelete: SetNull)
  artist    Artist?      @relation(fields: [artistId], references: [id], onDelete: SetNull)

  @@index([songId])
  @@index([artistId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("report")
}

enum ReportStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

