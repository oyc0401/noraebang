{"openapi":"3.0.0","paths":{"/search":{"get":{"description":"입력한 검색어를 곡 제목, 아티스트 이름, 노래방 번호 필드에서 동시에 검색하여 결과를 반환합니다.","operationId":"SearchController_search","parameters":[{"name":"q","required":true,"in":"query","description":"검색어","schema":{"type":"string"}},{"name":"provider","required":false,"in":"query","description":"노래방 기기 (예: TJ, KY)","schema":{"type":"string"}},{"name":"limit","required":false,"in":"query","description":"최대 반환 개수","schema":{"type":"string"}}],"responses":{"200":{"description":"검색 결과","content":{"application/json":{"schema":{"example":{"data":[{"id":101,"title":"夜に駆ける","artistName":"YOASOBI","karaokeNo":"12345","provider":"TJ"}]}}}}}},"summary":"통합 검색 (제목, 가수, 노래방 번호)","tags":["Search"]}},"/search/karaoke":{"get":{"description":"노래방 번호로 정확하게 검색합니다. provider 를 지정하면 특정 기기만 필터링할 수 있습니다.","operationId":"SearchController_searchByKaraokeNo","parameters":[{"name":"no","required":true,"in":"query","description":"노래방 번호","schema":{"type":"string"}},{"name":"provider","required":false,"in":"query","description":"노래방 기기 (예: TJ, KY)","schema":{"type":"string"}}],"responses":{"200":{"description":"검색 결과","content":{"application/json":{"schema":{"example":{"data":[{"id":101,"title":"夜に駆ける","artistName":"YOASOBI","karaokeNo":"12345","provider":"TJ"}]}}}}}},"summary":"노래방 곡 번호 검색","tags":["Search"]}},"/search/artist":{"get":{"description":"입력한 이름을 포함하는 아티스트를 검색하여 간단한 정보 목록을 반환합니다.","operationId":"SearchController_searchByArtist","parameters":[{"name":"name","required":true,"in":"query","description":"아티스트 이름","schema":{"type":"string"}}],"responses":{"200":{"description":"검색 결과","content":{"application/json":{"schema":{"example":{"data":[{"id":1,"name":"YOASOBI","alias":"yoasobi"}]}}}}}},"summary":"아티스트 이름으로 검색","tags":["Search"]}},"/search/title":{"get":{"description":"곡 제목 또는 한글 제목이 검색어를 포함하는 항목을 반환합니다.","operationId":"SearchController_searchByTitle","parameters":[{"name":"q","required":true,"in":"query","description":"곡 제목","schema":{"type":"string"}}],"