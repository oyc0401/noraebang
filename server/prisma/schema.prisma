generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Artist {
  id             Int     @id @default(autoincrement())
  homeCatalog    String? @map("home_catalog")
  name           String // 그냥 이름
  nameKo         String  @map("name_ko") // ai 돌려서 
  nameJa         String? @map("name_ja") // 일본어면 걍 넣기
  nameJaKana     String? @map("name_ja_kana") // 일본어 가나버전
  nameJaPronu    String? @map("name_ja_pronu") // kanabarum으로 만들기
  nameLatin      String? @map("name_latin") // 영어면 걍 넣기
  nameLatinPronu String? @map("name_latin_pronu") // konglish로 만들기
  tjName         String? @map("tj_name") // tj이름 그대로

  slug String? @unique // ai 돌리고, 유니크 테스트

  youtube_channel       String? @map("youtube_channel") // 유튜브 db에서 찾기
  youtube_topic_channel String? @map("youtube_topic_channel") // 토픽채널 찾기 파이프라인
  spotifyId             String? @map("spotify_id") // 스포티파이 검색하기

  thumbnailDefault String? @map("thumbnail_default") // 유튜브에서 찾기
  thumbnailHigh    String? @map("thumbnail_high") // 유튜브에서 찾기
  thumbnailMedium  String? @map("thumbnail_medium") // 유튜브에서 찾기

  spotifyTracksFetchedAt DateTime? @map("spotify_tracks_fetched_at")
  youtubeTracksFetchedAt DateTime? @map("youtube_tracks_fetched_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  artistSongs ArtistSong[]

  @@index([spotifyId])
  @@index([homeCatalog])
  @@map("artist")
}

model Song {
  id               Int       @id @default(autoincrement())
  title            String
  titleKo          String?   @map("title_ko")
  titleJa          String?   @map("title_ja")
  titleJaPronu     String?   @map("title_ja_pronu")
  titleJaKana      String?   @map("title_ja_kana")
  titleJaKanji     String?   @map("title_ja_kanji")
  titleLatin       String?   @map("title_latin")
  titleLatinPronu  String?   @map("title_latin_pronu")
  youtubeVideoId   String?   @map("youtube_video_id")
  youtubeFetchedAt DateTime? @map("youtube_fetched_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  thumbnailDefault String? @map("thumbnail_default")
  thumbnailHigh    String? @map("thumbnail_high")
  thumbnailMedium  String? @map("thumbnail_medium")

  catalog String?

  spotifyTrackGroupId Int?    @map("spotify_track_group_id")
  tjSongId            String? @unique @map("tj_song_id")

  score Float? @map("score")

  visible     Boolean      @default(false)
  artistSongs ArtistSong[]
  tjSong      TjSong?      @relation(fields: [tjSongId], references: [id])

  @@index([youtubeVideoId])
  @@index([catalog])
  @@index([spotifyTrackGroupId])
  @@index([tjSongId])
  @@map("song")
}

model ArtistSong {
  id        Int      @id @default(autoincrement())
  artistId  Int      @map("artist_id")
  songId    Int      @map("song_id")
  createdAt DateTime @default(now()) @map("created_at")
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([artistId, songId])
  @@index([songId])
  @@index([artistId])
  @@map("artist_song")
}

model TjSong {
  id           String   @id
  title        String // 제목
  artist       String? // 가수
  lyricist     String? // 작사기
  composer     String? // 작곡가
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  thumbnailImg String?  @map("thumbnail_img") // 썸네일
  publishdate  String?  @map("publishdate") // TJ측 등록 시간
  isMR         Boolean  @default(false) @map("is_mr") // MR 여부
  isMV         Boolean  @default(false) @map("is_mv") // MV 여부
  isOver60     Boolean  @default(false) @map("is_over_60") // 60이상기기 여부
  youtubeLink  String?  @map("youtube_link")
  song         Song?

  @@map("tj_song")
}

model SongQueue {
  id          Int      @id @default(autoincrement())
  tjNumber    String   @map("tj_number")
  title       String
  artist      String?
  publishdate String?  @map("publishdate")
  catalog     String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([tjNumber])
  @@map("song_queue")
}

model SongArtistQueue {
  id        Int      @id @default(autoincrement())
  tjSongId  String   @unique @map("tj_song_id")
  artistId  Int?     @map("artist_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([artistId])
  @@map("song_artist_queue")
}

model ArtistCreationQueue {
  id       Int     @id @default(autoincrement())
  tjSongId String? @unique @map("tj_song_id")

  homeCatalog    String? @map("home_catalog") // 아마 jpop
  name           String // 그대로 넘기기
  nameKo         String  @map("name_ko") // ai 돌려서 
  nameJa         String? @map("name_ja") // 일본어면 걍 넣기
  nameJaKana     String? @map("name_ja_kana") // 일본어 가나버전
  nameJaPronu    String? @map("name_ja_pronu") // kanabarum으로 만들기
  nameLatin      String? @map("name_latin") // 영어면 걍 넣기
  nameLatinPronu String? @map("name_latin_pronu") // konglish로 만들기
  tjName         String? @map("tj_name") // tj이름 그대로

  slug String? @unique // ai 돌리고, 유니크 테스트

  youtube_channel       String? @map("youtube_channel") // 유튜브 db에서 찾기
  youtube_topic_channel String? @map("youtube_topic_channel") // 유튜브 db에서 찾기
  spotifyId             String? @map("spotify_id") // 스포티파이 검색하기

  thumbnailDefault String? @map("thumbnail_default") // 유튜브에서 찾기
  thumbnailHigh    String? @map("thumbnail_high") // 유튜브에서 찾기
  thumbnailMedium  String? @map("thumbnail_medium") // 유튜브에서 찾기

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("artist_creation_queue")
}

model SongCreationQueue {
  id       Int     @id @default(autoincrement())
  tjSongId String? @unique @map("tj_song_id")

  catalog String?

  title           String // 그냥 넘기기
  titleKo         String? @map("title_ko") // ai 돌려서
  titleJa         String? @map("title_ja") // 일본어면 걍 넣기
  titleJaPronu    String? @map("title_ja_pronu") // kanabarum으로 만들기
  titleJaKana     String? @map("title_ja_kana") // 일본어 가나버전
  titleJaKanji    String? @map("title_ja_kanji") // 일본어 한자버전
  titleLatin      String? @map("title_latin") // 영어면 걍 넣기
  titleLatinPronu String? @map("title_latin_pronu") // konglish로 만들기
  tjTitle         String? @map("tj_title") // tj제목 그대로
  tjArtist        String? @map("tj_artist") // tj가수 그대로

  youtubeVideoId   String?   @map("youtube_video_id") // 유튜브에서 찾기
  thumbnailDefault String? @map("thumbnail_default") // 유튜브에서 찾기
  thumbnailHigh    String? @map("thumbnail_high") // 유튜브에서 찾기
  thumbnailMedium  String? @map("thumbnail_medium") // 유튜브에서 찾기

  spotifyTrackId Int?    @map("spotify_track_id") // 스포티파이 검색

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("song_creation_queue")
}

model User {
  id          Int      @id @default(autoincrement())
  email       String?  @unique
  password    String?
  lastLoginAt DateTime @default(now()) @map("last_login_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("user")
}
