# Database
DATABASE_URL=postgresql://user:password@localhost:5432/noraebang

# YouTube Music API
# 쿠키 획득 방법:
# 1. YouTube Music (https://music.youtube.com) 접속
# 2. 로그인
# 3. 개발자 도구 열기 (F12)
# 4. Network 탭 선택
# 5. 아티스트 페이지나 검색 수행
# 6. '/browse' 요청 찾기 (필터에 'browse' 입력)
# 7. Request Headers 섹션에서 'cookie' 값 전체 복사
# 8. 아래에 붙여넣기
YOUTUBE_MUSIC_COOKIE=

# Typesense (optional)
TYPESENSE_API_KEY=
TYPESENSE_HOST=
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
