{
  "name": "song",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "admin",
    "frontend"
  ],
  "scripts": {
    "dev:server": "pnpm --filter server start:dev",
    "dev:admin": "pnpm --filter admin start:dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:frontend-only": "pnpm run dev:frontend",
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:admin\" \"pnpm run dev:frontend\"",
    "build:server": "pnpm --filter server build",
    "build:admin": "pnpm --filter admin build",
    "build:frontend": "pnpm --filter frontend build",
    "build": "pnpm run build:server && pnpm run build:admin && pnpm run build:frontend",
    "typecheck:server": "pnpm --filter server typecheck",
    "typecheck:admin": "pnpm --filter admin typecheck",
    "typecheck:frontend": "pnpm --filter frontend typecheck",
    "typecheck": "pnpm run typecheck:server && pnpm run typecheck:admin && pnpm run typecheck:frontend",
    "build:no-assets": "pnpm run typecheck",
    "generate": "pnpm run generate:server && pnpm run generate:admin",
    "generate:server": "pnpm --filter server exec prisma generate",
    "generate:admin": "pnpm --filter admin exec prisma generate",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "concurrently": "^8.2.2",
    "tsx": "^4.22.4"
  }
}
