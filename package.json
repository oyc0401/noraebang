{
  "name": "song",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "admin",
    "frontend",
    "manager"
  ],
  "scripts": {
    "dev:server": "npm run start:dev --workspace=server",
    "dev:admin": "npm run start:dev --workspace=admin",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:manager": "npm run dev --workspace=manager",
    "dev:frontend-only": "concurrently \"npm run dev:frontend\" \"npm run dev:manager\"",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:admin\" \"npm run dev:frontend\" \"npm run dev:manager\"",
    "build:server": "npm run build --workspace=server",
    "build:admin": "npm run build --workspace=admin",
    "build:frontend": "npm run build --workspace=frontend",
    "build:manager": "npm run build --workspace=manager",
    "build": "npm run build:server && npm run build:admin && npm run build:frontend",
    "generate": "pnpm --filter server exec prisma generate && pnpm --filter manager exec prisma generate",
    "generate:server": "pnpm --filter server exec prisma generate",
    "generate:manager": "pnpm --filter manager exec prisma generate",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "concurrently": "^8.2.2"
  }
}
